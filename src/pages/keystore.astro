---
import MainLayout from "~/layouts/layout-main.astro";
import ToolPageHeader from "~/components/tool-page-header.astro";
import KeystoreTool from "~/components/keystore-tool.tsx";
---

<MainLayout
  title="Android Keystore Fingerprints | Tools"
  description="Extract SHA-1 and SHA-256 signing certificate fingerprints from a JKS or PKCS#12 keystore locally in your browser."
>
  <main class="container flex-1 py-8 sm:py-10">
    <ToolPageHeader
      title="Android Keystore Fingerprints"
      description="Find SHA-1 and SHA-256 from your upload keystore and key.properties without sending them to a server."
      privacyNote="Keystores stay local"
      icon="key"
    />
    <KeystoreTool client:load />
  </main>
</MainLayout>
