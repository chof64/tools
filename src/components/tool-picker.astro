---
interface Tool {
  href: string;
  title: string;
  caption: string;
  icon: "key" | "binary";
}

const base = import.meta.env.BASE_URL;

const tools: Tool[] = [
  {
    href: base + "jwks/",
    title: "JWKS Generator",
    caption: "Generate signing keys and a matching public JWKS.",
    icon: "key",
  },
  {
    href: base + "base64/",
    title: "Base64",
    caption: "Encode or decode text and files locally.",
    icon: "binary",
  },
];
---

<div class="launcher-grid">
  {
    tools.map(({ href, title, caption, icon }) => (
      <a href={href} class="launcher-item group" aria-label={title}>
        <span
          class:list={[
            "launcher-icon",
            icon === "key" ? "launcher-icon-key" : "launcher-icon-binary",
          ]}
          aria-hidden="true"
        >
          {icon === "key" ? (
            <svg viewBox="0 0 24 24" class="relative z-10 size-11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"></path>
              <path d="m21 2-9.6 9.6"></path>
              <circle cx="7.5" cy="15.5" r="5.5"></circle>
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" class="relative z-10 size-11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7h2v4H7z"></path>
              <path d="M15 13h2v4h-2z"></path>
              <path d="M7 17h4"></path>
              <path d="M13 7h4"></path>
              <path d="M9 13H7v4"></path>
              <path d="M15 7h2v4"></path>
            </svg>
          )}
        </span>
        <span class="launcher-label">{title}</span>
        <span class="launcher-caption">{caption}</span>
      </a>
    ))
  }
</div>
